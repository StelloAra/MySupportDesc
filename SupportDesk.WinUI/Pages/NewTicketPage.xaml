<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportDesk.WinUI.Pages.NewTicketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDesk.WinUI.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="8">
        <ScrollViewer>
            <StackPanel
            Spacing="20"
            MaxWidth="700"
            HorizontalAlignment="Left">

                <TextBlock
                Text="Create New Ticket"
                FontSize="32"
                FontWeight="SemiBold" />

                <StackPanel Spacing="8">
                    <TextBlock
                    Text="Title"
                    FontWeight="SemiBold" />

                    <TextBox
                    x:Name="TitleTextBox"
                    PlaceholderText="Enter ticket title" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                    Text="Customer"
                    FontWeight="SemiBold" />

                    <ComboBox
                    x:Name="CustomerComboBox"
                    PlaceholderText="Select customer"
                    HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                    Text="Description"
                    FontWeight="SemiBold" />

                    <TextBox
                    x:Name="DescriptionTextBox"
                    PlaceholderText="Describe the problem"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="140" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                    Text="Priority"
                    FontWeight="SemiBold" />

                    <ComboBox
                    x:Name="PriorityComboBox"
                    SelectedIndex="1"
                    HorizontalAlignment="Stretch">

                        <ComboBoxItem Content="Low" />
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="High" />

                    </ComboBox>
                </StackPanel>

                <StackPanel
    Orientation="Horizontal"
    Spacing="12"
    HorizontalAlignment="Left"
    Margin="0,0,0,24">

                    <Button
        Content="Cancel"
        Padding="20,8"
        Click="CancelButton_Click" />

                    <Button
        Content="Create Ticket"
        Padding="20,8"
        Click="CreateTicketButton_Click" />

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

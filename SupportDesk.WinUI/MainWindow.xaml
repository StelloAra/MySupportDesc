<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SupportDesk.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDesk.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SupportDesk.WinUI">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border
        Grid.Column="0"
        Padding="16">

            <StackPanel Spacing="12">

                <TextBlock
                Text="SupportDesk"
                FontSize="24"
                FontWeight="SemiBold"
                Margin="8,8,8,24" />

                <Button
                x:Name="DashboardButton"
                Content="🏠  Dashboard"
                HorizontalAlignment="Stretch"
                Click="DashboardButton_Click"/>

                <Button
                Content="🎫  Tickets"
                HorizontalAlignment="Stretch"
                Click="TicketsButton_Click" />

                <Button
                Content="👥  Customers"
                HorizontalAlignment="Stretch"
                Click="CustomersButton_Click"/>

                <Border
                Height="1"
                Margin="8,12"
                Opacity="0.3" />

                <Button
                Content="➕  New Ticket"
                HorizontalAlignment="Stretch"
                Click="NewTicketButton_Click"/>

            </StackPanel>
        </Border>

        <!-- Main content -->
        <Frame
             x:Name="ContentFrame"
             Grid.Column="1"
              Padding="32" />

    </Grid>
</Window>
